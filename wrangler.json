{
  "compatibility_date": "2025-04-01",
  "main": "src/index.ts",
  "name": "leblanctesting",
  "assets": {
    "directory": "public"
  },
  "vars": {
    "SITE_NAME": "MXB Setup Shop",
    "CURRENCY": "usd",
    "DOWNLOAD_WINDOW_DAYS": "7"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mxbikes-shop-files"
    }
  ],
  // Retires the Durable Object from the globe template this project started from.
  "migrations": [
    {
      "new_classes": ["Globe"],
      "tag": "v1"
    },
    {
      "deleted_classes": ["Globe"],
      "tag": "v2"
    }
  ],
  "observability": {
    "enabled": true
  }
}
